## Copy this file to local.properties and fill in your keys.
## local.properties is gitignored — never commit real keys.

## Required for cloud conversation fallback (https://ai.google.dev/)
GEMINI_API_KEY=your_gemini_key_here

## Optional — weather on the HUD (https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_key_here

## Optional — fast Groq LLM fallback (https://console.groq.com/)
GROQ_API_KEY=your_groq_key_here

## Picovoice AccessKey — on-device wake word "Jarvis" (Porcupine)
## Free key: https://console.picovoice.ai/
PICOVOICE_ACCESS_KEY=your_picovoice_access_key_here

## ElevenLabs — human / cinematic Jarvis speaking voice
## Free key: https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
## Optional — pick a male British-style voice in the Voice Library and paste its ID
## Default (if empty): Adam (deep male) pNInz6obpgDQGcFmaJgB
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

## Standard Android SDK path (Android Studio usually writes this for you)
# sdk.dir=/path/to/Android/Sdk
