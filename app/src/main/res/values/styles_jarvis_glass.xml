<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="JG.Text.Title">
        <item name="android:textColor">#00E5FF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
    <style name="JG.Text.Section">
        <item name="android:textColor">#00E5FF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="JG.Text.Body">
        <item name="android:textColor">#A8D4E0</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="JG.Text.Muted">
        <item name="android:textColor">#5C8A94</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="JG.Button.Primary" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_jg_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
</resources>
