<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="12dp"
    android:background="@drawable/widget_jarvis_bg">

    <TextView
        android:id="@+id/widgetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="J.A.R.V.I.S"
        android:textColor="#FFB040"
        android:textSize="12sp"
        android:letterSpacing="0.12"
        android:fontFamily="monospace"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="SYSTEMS NOMINAL"
        android:textColor="#CC7A20"
        android:textSize="9sp"
        android:fontFamily="monospace" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:padding="6dp">

        <TextView
            android:id="@+id/widgetBatt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BATT  —%"
            android:textColor="#FFB040"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/widgetNet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="NET   —"
            android:textColor="#FFB040"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/widgetRam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="RAM   —%"
            android:textColor="#FFB040"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_reactor_ring"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/widgetMicButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mark42"
            android:contentDescription="@string/app_name" />
    </FrameLayout>

    <TextView
        android:id="@+id/widgetHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TAP TO LISTEN"
        android:textColor="#FF8C00"
        android:textSize="9sp"
        android:letterSpacing="0.10"
        android:fontFamily="monospace" />
</LinearLayout>
