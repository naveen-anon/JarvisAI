<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="12dp"
    android:background="@drawable/widget_jarvis_bg">

    <TextView
        android:id="@+id/widgetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="J.A.R.V.I.S"
        android:textColor="#00D9FF"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <TextView
        android:id="@+id/widgetStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="STANDING BY"
        android:textColor="#5A8A99"
        android:textSize="9sp"
        android:fontFamily="monospace" />

    <!-- Arc reactor (bitmap set from provider) -->
    <ImageView
        android:id="@+id/widgetReactor"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="Arc reactor" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:paddingStart="4dp">

        <TextView
            android:id="@+id/widgetBatt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BATT —%"
            android:textColor="#B8ECFF"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/widgetNet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="NET —"
            android:textColor="#B8ECFF"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/widgetRam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="TAP REACTOR TO LISTEN"
            android:textColor="#5A8A99"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="LISTEN"
        android:textColor="#00D9FF"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:textStyle="bold" />
</LinearLayout>
