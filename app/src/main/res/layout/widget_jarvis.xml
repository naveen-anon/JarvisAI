<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="14dp"
    android:background="@drawable/widget_jarvis_bg">

    <TextView
        android:id="@+id/widgetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="J.A.R.V.I.S"
        android:textColor="#00D9FF"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="STANDING BY"
        android:textColor="#5A8A99"
        android:textSize="9sp"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/widgetBatt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="BATT —%"
        android:textColor="#B8ECFF"
        android:textSize="11sp"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/widgetNet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="NET —"
        android:textColor="#B8ECFF"
        android:textSize="11sp"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/widgetRam"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="TAP MIC TO LISTEN"
        android:textColor="#5A8A99"
        android:textSize="10sp"
        android:fontFamily="monospace" />

    <ImageView
        android:id="@+id/widgetMicButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:padding="14dp"
        android:background="@drawable/widget_mic_glow"
        android:src="@drawable/ic_mic"
        android:contentDescription="Listen" />

    <TextView
        android:id="@+id/widgetHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="LISTEN"
        android:textColor="#007A99"
        android:textSize="9sp"
        android:fontFamily="monospace" />
</LinearLayout>
