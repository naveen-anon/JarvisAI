<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#03080E"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/btnCoreBack" android:layout_width="40dp" android:layout_height="40dp"
                android:gravity="center" android:text="←" android:textColor="#00D9FF" android:textSize="20sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="SYSTEM CORE" android:textColor="#00D9FF" android:textSize="16sp"
                    android:textStyle="bold" android:fontFamily="monospace" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="STARK MARK-VII DIAGNOSTICS" android:textColor="#5A8A99"
                    android:textSize="10sp" android:fontFamily="monospace" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="● LIVE" android:textColor="#22C55E" android:textSize="11sp"
                android:fontFamily="monospace" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_glass_card"
            android:padding="16dp" android:layout_marginTop="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="CORE UPTIME" android:textColor="#5A8A99" android:textSize="10sp" android:fontFamily="monospace" />
            <TextView android:id="@+id/txtUptime" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—" android:textColor="#F0FBFF"
                android:textSize="22sp" android:fontFamily="monospace" android:textStyle="bold" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/txtDeviceModel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—" android:textColor="#B8ECFF"
                android:textSize="12sp" android:fontFamily="monospace" android:layout_marginTop="6dp" />
            <TextView android:id="@+id/txtNeuralProtocol" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="NEURAL PROTOCOL: ONLINE"
                android:textColor="#22C55E" android:textSize="11sp" android:fontFamily="monospace" android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:background="@drawable/bg_glass_card"
            android:padding="14dp" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/txtBatteryPct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#00D9FF" android:textSize="20sp" android:fontFamily="monospace" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="POWER" android:textColor="#00D9FF" android:textSize="10sp" android:fontFamily="monospace" />
                <ProgressBar android:id="@+id/barBattery" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="6dp" android:max="100" android:progressDrawable="@drawable/progress_cyan" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingStart="6dp" android:paddingEnd="6dp">
                <TextView android:id="@+id/txtMemoryPct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#B388FF" android:textSize="20sp" android:fontFamily="monospace" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MEMORY" android:textColor="#B388FF" android:textSize="10sp" android:fontFamily="monospace" />
                <ProgressBar android:id="@+id/barMemory" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="6dp" android:max="100" android:progressDrawable="@drawable/progress_purple" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/txtStoragePct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFB020" android:textSize="20sp" android:fontFamily="monospace" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STORAGE" android:textColor="#FFB020" android:textSize="10sp" android:fontFamily="monospace" />
                <ProgressBar android:id="@+id/barStorage" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="6dp" android:max="100" android:progressDrawable="@drawable/progress_amber" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_glass_card"
            android:padding="14dp" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="ARC REACTOR POWER MATRIX" android:textColor="#00D9FF" android:textSize="11sp" android:fontFamily="monospace" android:textStyle="bold" />
                <TextView android:id="@+id/txtChargeStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textColor="#22C55E" android:textSize="11sp" android:fontFamily="monospace" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CELL TEMP" android:textColor="#5A8A99" android:textSize="9sp" android:fontFamily="monospace" />
                    <TextView android:id="@+id/txtTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#B8ECFF" android:textSize="16sp" android:fontFamily="monospace" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VOLTAGE" android:textColor="#5A8A99" android:textSize="9sp" android:fontFamily="monospace" />
                    <TextView android:id="@+id/txtVoltage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#B8ECFF" android:textSize="16sp" android:fontFamily="monospace" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HEALTH" android:textColor="#5A8A99" android:textSize="9sp" android:fontFamily="monospace" />
                    <TextView android:id="@+id/txtHealth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GOOD" android:textColor="#22C55E" android:textSize="16sp" android:fontFamily="monospace" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_glass_card"
            android:padding="14dp" android:layout_marginTop="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="COMMS AND NETWORK UPLINK" android:textColor="#00D9FF" android:textSize="11sp" android:fontFamily="monospace" android:textStyle="bold" />
            <TextView android:id="@+id/txtNetworkStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="—" android:textColor="#22C55E" android:textSize="12sp" android:fontFamily="monospace" android:layout_marginTop="6dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOCAL IPV4" android:textColor="#5A8A99" android:textSize="9sp" android:fontFamily="monospace" />
                    <TextView android:id="@+id/txtIp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#00D9FF" android:textSize="14sp" android:fontFamily="monospace" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LINK" android:textColor="#5A8A99" android:textSize="9sp" android:fontFamily="monospace" />
                    <TextView android:id="@+id/txtBandwidth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#00D9FF" android:textSize="14sp" android:fontFamily="monospace" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_glass_card"
            android:padding="14dp" android:layout_marginTop="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="NEURAL PROCESSOR ARCHITECTURE" android:textColor="#00D9FF" android:textSize="11sp" android:fontFamily="monospace" android:textStyle="bold" />
            <TextView android:id="@+id/txtCpu" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="—" android:textColor="#B8ECFF" android:textSize="12sp" android:fontFamily="monospace" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/txtPlatform" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="—" android:textColor="#B8ECFF" android:textSize="12sp" android:fontFamily="monospace" android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_glass_card"
            android:padding="14dp" android:layout_marginTop="10dp" android:layout_marginBottom="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="DIAGNOSTIC STREAM" android:textColor="#00D9FF" android:textSize="11sp" android:fontFamily="monospace" android:textStyle="bold" />
            <TextView android:id="@+id/txtDiagStream" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="—" android:textColor="#22C55E" android:textSize="11sp" android:fontFamily="monospace" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
