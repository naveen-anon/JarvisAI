<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020810">

    <TextView
        android:id="@+id/txtVisionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="VISUAL SCANNER"
        android:textColor="#00E5FF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:padding="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnVisionClose" />

    <TextView
        android:id="@+id/btnVisionClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← CLOSE"
        android:textColor="#00E5FF"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:padding="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        app:layout_constraintTop_toBottomOf="@id/txtVisionTitle"
        app:layout_constraintBottom_toTopOf="@id/modeRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Center frame hint -->
    <View
        android:id="@+id/scanFrame"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_scan_frame"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView" />

    <LinearLayout
        android:id="@+id/modeRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        app:layout_constraintBottom_toTopOf="@id/btnCapture"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnModeOcr"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_quick_chip"
            android:gravity="center"
            android:text="Text"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:fontFamily="monospace" />
        <TextView
            android:id="@+id/btnModeObjects"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_quick_chip"
            android:gravity="center"
            android:text="Object"
            android:textColor="#5C8A94"
            android:textSize="12sp"
            android:fontFamily="monospace" />
        <TextView
            android:id="@+id/btnModeFaces"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_quick_chip"
            android:gravity="center"
            android:text="Faces"
            android:textColor="#5C8A94"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnCapture"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_capture_ring"
        android:gravity="center"
        android:text="◉"
        android:textColor="#00E5FF"
        android:textSize="22sp"
        app:layout_constraintBottom_toTopOf="@id/resultScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/resultScroll"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_margin="10dp"
        android:background="#0A1520"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtVisionResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Point camera and tap Text / Object / Faces — or the shutter."
            android:textColor="#9FD8F4"
            android:textSize="13sp"
            android:fontFamily="monospace" />
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
