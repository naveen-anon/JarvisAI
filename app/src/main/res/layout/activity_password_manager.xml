<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#03080E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/liquid_glass_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/glass_chip_bg"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="◉"
                android:textColor="#00D9FF"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:text="J.A.R.V.I.S"
                    android:textColor="#00D9FF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Artificial Intelligence Assistant"
                    android:textColor="#5A8A99"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnPwmLock"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/glass_button_bg"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="🔒 LOCK"
                android:textColor="#00D9FF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/liquid_glass_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="🛡"
                android:textColor="#00D9FF"
                android:textSize="18sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="PASSWORD VAULT"
                android:textColor="#00D9FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="SECURE · PRIVATE · YOURS"
                android:textColor="#FFAA00"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="● AES-256  ·  ON-DEVICE ENCRYPTION  🔒"
            android:textColor="#00D9FF"
            android:textSize="10sp" />

        <!-- Main card: setup OR list -->
        <LinearLayout
            android:id="@+id/pwmSetupCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/liquid_glass_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.06"
                        android:text="CREATE SECURE"
                        android:textColor="#E8FBFF"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.08"
                        android:text="VAULT"
                        android:textColor="#00D9FF"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/glass_chip_bg"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="🔒"
                    android:textSize="22sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtPwmStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:text="Set a master PIN (min 4).\nEncrypts passwords on this device."
                android:textColor="#8AB4C0"
                android:textSize="12sp" />

            <!-- PIN field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/glass_button_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="🔐"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="MASTER PIN"
                        android:textColor="#5A8A99"
                        android:textSize="9sp" />

                    <EditText
                        android:id="@+id/pwmOverlayInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:fontFamily="monospace"
                        android:hint="Enter minimum 4 digits"
                        android:inputType="numberPassword"
                        android:padding="0dp"
                        android:textColor="#E8FBFF"
                        android:textColorHint="#3D6A7A"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Strength -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="PIN STRENGTH"
                    android:textColor="#5A8A99"
                    android:textSize="9sp" />

                <LinearLayout
                    android:id="@+id/pwmStrengthRow"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/txtPwmStrength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="—"
                    android:textColor="#00D9FF"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Biometric row (visual + preference) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/glass_button_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="指紋"
                    android:textColor="#00D9FF"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="指紋"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="USE BIOMETRIC (FINGERPRINT)\nQuick &amp; secure access"
                    android:textColor="#B8ECFF"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchPwmBio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <!-- Feature chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_chip_bg"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="ENCRYPTED\nON-DEVICE"
                    android:textColor="#00D9FF"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_chip_bg"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="AES-256\nENCRYPTION"
                    android:textColor="#00D9FF"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_chip_bg"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="BIOMETRIC\nOPTION"
                    android:textColor="#00D9FF"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_chip_bg"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="ZERO\nEXTERNAL"
                    android:textColor="#00D9FF"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPwmBack"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_button_bg"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="✕  CLOSE"
                    android:textColor="#5A8A99"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pwmOverlayOk"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/glass_button_filled"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="🔒  CREATE VAULT"
                    android:textColor="#03080E"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Unlocked list section -->
        <LinearLayout
            android:id="@+id/pwmListSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnPwmAdd"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/glass_button_filled"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="+ ADD ENTRY"
                android:textColor="#03080E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/pwmList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Hidden legacy ids for code compatibility -->
        <FrameLayout
            android:id="@+id/pwmOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/pwmOverlayCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView android:id="@+id/pwmOverlayTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" />
                <TextView android:id="@+id/pwmOverlayMsg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" />
                <LinearLayout android:id="@+id/pwmAddFields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <TextView android:id="@+id/pwmOverlayCancel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CANCEL" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="—  J.A.R.V.I.S  ·  SECURE YOUR DIGITAL LIFE  —"
            android:textColor="#2A4A55"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
