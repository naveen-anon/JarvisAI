<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#03080E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPwmBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="←"
                android:textColor="#00D9FF"
                android:textSize="20sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="PASSWORD VAULT"
                android:textColor="#00D9FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPwmLock"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/glass_button_bg"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="LOCK"
                android:textColor="#00D9FF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtPwmStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:text="—"
            android:textColor="#5A8A99"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnPwmAdd"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/glass_button_filled"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="+ ADD ENTRY"
            android:textColor="#03080E"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/pwmList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="Encrypted on-device · liquid glass vault"
            android:textColor="#2A4A55"
            android:textSize="10sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/pwmOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99020810"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/pwmOverlayCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="28dp"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/pwmOverlayTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:text="UNLOCK VAULT"
                android:textColor="#00D9FF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pwmOverlayMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="Enter master PIN"
                android:textColor="#8AB4C0"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/pwmOverlayInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:hint="Master PIN"
                android:inputType="numberPassword"
                android:textColor="#E8FBFF"
                android:textColorHint="#5A8A99"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/pwmAddFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pwmOverlayCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/glass_button_bg"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:text="CLOSE"
                    android:textColor="#5A8A99"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pwmOverlayOk"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/glass_button_filled"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:text="UNLOCK"
                    android:textColor="#03080E"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
