<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#03080E">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewWatch"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="#E003080E">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PERIMETER · SECURITY WATCH"
            android:textColor="#00D9FF"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/txtWatchStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="ARMED · scanning"
            android:textColor="#B8ECFF"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/txtWatchMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ON-DEVICE FACE ML · 10s ALERT COOLDOWN"
            android:textColor="#5A8A99"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnWatchStop"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:gravity="center"
        android:text="DISARM WATCH"
        android:textColor="#03080E"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:background="#00D9FF" />
</FrameLayout>
