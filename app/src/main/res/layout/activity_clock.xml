<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#03080E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnClockBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="←"
                android:textColor="#00D9FF"
                android:textSize="20sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="CLOCK"
                android:textColor="#00D9FF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabAlarm"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/glass_button_bg"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="ALARM"
                android:textColor="#00D9FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabTimer"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/glass_button_bg"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="TIMER"
                android:textColor="#5A8A99"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabStopwatch"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/glass_button_bg"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="STOPWATCH"
                android:textColor="#5A8A99"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ALARM -->
        <LinearLayout
            android:id="@+id/panelAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/glass_card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="SET ALARM"
                android:textColor="#B8ECFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:text="Uses system clock app (reliable overnight alarms)."
                android:textColor="#5A8A99"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/inputAlarmHour"
                    android:layout_width="72dp"
                    android:layout_height="48dp"
                    android:background="@drawable/glass_button_bg"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:hint="HH"
                    android:inputType="number"
                    android:text="07"
                    android:textColor="#E8FBFF"
                    android:textColorHint="#5A8A99"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:text=":"
                    android:textColor="#00D9FF"
                    android:textSize="22sp" />

                <EditText
                    android:id="@+id/inputAlarmMin"
                    android:layout_width="72dp"
                    android:layout_height="48dp"
                    android:background="@drawable/glass_button_bg"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:hint="MM"
                    android:inputType="number"
                    android:text="00"
                    android:textColor="#E8FBFF"
                    android:textColorHint="#5A8A99"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSetAlarm"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/glass_button_filled"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="SET ALARM"
                android:textColor="#03080E"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TIMER -->
        <LinearLayout
            android:id="@+id/panelTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/glass_card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtTimerDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="00:00.00"
                android:textColor="#00D9FF"
                android:textSize="40sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/inputTimerMin"
                    android:layout_width="72dp"
                    android:layout_height="44dp"
                    android:background="@drawable/glass_button_bg"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:hint="min"
                    android:inputType="number"
                    android:text="5"
                    android:textColor="#E8FBFF"
                    android:textColorHint="#5A8A99" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:text=":"
                    android:textColor="#00D9FF"
                    android:textSize="18sp" />

                <EditText
                    android:id="@+id/inputTimerSec"
                    android:layout_width="72dp"
                    android:layout_height="44dp"
                    android:background="@drawable/glass_button_bg"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:hint="sec"
                    android:inputType="number"
                    android:text="0"
                    android:textColor="#E8FBFF"
                    android:textColorHint="#5A8A99" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnTimerStart"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_button_filled"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="START"
                    android:textColor="#03080E"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnTimerPause"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_button_bg"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="PAUSE"
                    android:textColor="#00D9FF"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnTimerReset"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_button_bg"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="RESET"
                    android:textColor="#00D9FF"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- STOPWATCH -->
        <LinearLayout
            android:id="@+id/panelStopwatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/glass_card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtStopwatchDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="00:00.00"
                android:textColor="#00D9FF"
                android:textSize="40sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSwStart"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_button_filled"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="START"
                    android:textColor="#03080E"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSwPause"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_button_bg"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="PAUSE"
                    android:textColor="#00D9FF"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSwReset"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_button_bg"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="RESET"
                    android:textColor="#00D9FF"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="Voice: set alarm 7:30 · timer 5 minutes · start stopwatch"
            android:textColor="#2A4A55"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
