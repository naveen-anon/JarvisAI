<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/armorTabs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/tabArmorHome"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingHorizontal="14dp" android:paddingVertical="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_armor_tab"
            android:text="Home" android:textColor="#FFD54F"
            android:textSize="11sp" android:fontFamily="monospace"/>
        <TextView android:id="@+id/tabArmorList"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingHorizontal="14dp" android:paddingVertical="6dp"
            android:layout_marginEnd="6dp"
            android:text="Suits" android:textColor="#99FFCC80"
            android:textSize="11sp" android:fontFamily="monospace"/>
        <TextView android:id="@+id/tabArmorStatus"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingHorizontal="14dp" android:paddingVertical="6dp"
            android:text="Status" android:textColor="#99FFCC80"
            android:textSize="11sp" android:fontFamily="monospace"/>
    </LinearLayout>

    <TextView
        android:id="@+id/txtArmorHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="ARMOR SUITS"
        android:textColor="#FFB300"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:letterSpacing="0.12"
        app:layout_constraintTop_toBottomOf="@id/armorTabs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtArmorSub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Gold reactor archive · equip to adapt systems"
        android:textColor="#99FFCC80"
        android:textSize="11sp"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/txtArmorHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <FrameLayout
        android:id="@+id/armorOrb"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/txtArmorSub"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <View android:layout_width="220dp" android:layout_height="220dp"
            android:layout_gravity="center" android:background="@drawable/bg_armor_orb_outer"/>
        <View android:layout_width="150dp" android:layout_height="150dp"
            android:layout_gravity="center" android:background="@drawable/bg_armor_orb_mid"/>
        <View android:layout_width="64dp" android:layout_height="64dp"
            android:layout_gravity="center" android:background="@drawable/bg_armor_orb_core"/>
        <ImageView
            android:id="@+id/imgArmorSuit"
            android:layout_width="110dp"
            android:layout_height="165dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_armor_silhouette"
            android:contentDescription="armor"/>
    </FrameLayout>

    <TextView
        android:id="@+id/txtSelectedMark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MARK I · PROTOTYPE"
        android:textColor="#FFD54F"
        android:textSize="13sp"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/armorOrb"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <HorizontalScrollView
        android:id="@+id/armorChipScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/txtSelectedMark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:id="@+id/armorChipRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp">
            <TextView android:id="@+id/chip_mk1" style="@style/ArmorChip" android:text="MK I"/>
            <TextView android:id="@+id/chip_mk3" style="@style/ArmorChip" android:text="MK III"/>
            <TextView android:id="@+id/chip_mk5" style="@style/ArmorChip" android:text="MK V"/>
            <TextView android:id="@+id/chip_mk42" style="@style/ArmorChip" android:text="MK 42"/>
            <TextView android:id="@+id/chip_mk50" style="@style/ArmorChip" android:text="MK 50"/>
            <TextView android:id="@+id/chip_mk85" style="@style/ArmorChip" android:text="MK 85"/>
            <TextView android:id="@+id/chip_hulk" style="@style/ArmorChip" android:text="HULKBUSTER"/>
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/armorInfoPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_armor_panel"
        android:padding="14dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/armorChipScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/txtArmorDesc"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Prototype armor. Heavy plating. Limited flight."
            android:textColor="#FFE082" android:textSize="12sp" android:fontFamily="monospace"/>
        <TextView android:id="@+id/txtArmorStats"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="PWR · 42%   FLIGHT · NO   WEAPONS · BASIC"
            android:textColor="#FFB300" android:textSize="11sp" android:fontFamily="monospace"/>
        <TextView android:id="@+id/txtArmorMode"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="VOICE PITCH · 0.95   REACTOR · GOLD"
            android:textColor="#99FFCC80" android:textSize="11sp" android:fontFamily="monospace"/>
    </LinearLayout>

    <TextView
        android:id="@+id/btnEquipArmor"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_armor_panel"
        android:gravity="center"
        android:text="EQUIP SUIT"
        android:textColor="#FFD54F"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/armorInfoPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
