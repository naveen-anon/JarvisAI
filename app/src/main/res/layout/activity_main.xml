<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_screen_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <!-- soft ambient only — no hard corner brackets -->
    <com.jarvis.assistant.ui.HudOverlayView
        android:id="@+id/hudOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.35"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <LinearLayout
        android:id="@+id/topBrandRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtSystemLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="JARVIS"
            android:textColor="@color/hud_cyan"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:fontFamily="@font/share_tech_mono" />

        <TextView
            android:id="@+id/txtClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/hud_text_dim"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/txtChatBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="💬"
            android:textSize="15sp"
            android:background="@drawable/bg_quick_chip"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/txtSettingsBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="⚙"
            android:textColor="@color/hud_cyan"
            android:textSize="15sp"
            android:background="@drawable/bg_quick_chip" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/statusChipStrip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/topBrandRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hey Jarvis"
            android:textColor="@color/hud_cyan"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
        <TextView android:id="@+id/txtBattery" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="BAT" android:textColor="@color/hud_text_dim" android:textSize="10sp" android:fontFamily="monospace" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/txtNetwork" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="NET" android:textColor="@color/hud_text_dim" android:textSize="10sp" android:fontFamily="monospace" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/txtPerf" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="OK" android:textColor="@color/hud_text_dim" android:textSize="10sp" android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/locWeatherRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/statusChipStrip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/txtLocation" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="" android:textColor="#3A5A68" android:textSize="10sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/txtWeather" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#3A5A68" android:textSize="10sp" android:fontFamily="monospace" />
    </LinearLayout>

    <com.jarvis.assistant.ui.ArcReactorView
        android:id="@+id/arcReactor"
        android:layout_width="210dp"
        android:layout_height="210dp"
        app:layout_constraintTop_toBottomOf="@id/locWeatherRow"
        app:layout_constraintBottom_toTopOf="@id/txtTapHint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.3" />

    <TextView
        android:id="@+id/txtTapHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Listening…"
        android:textColor="@color/hud_cyan_dim"
        android:textSize="12sp"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/arcReactor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="2dp" />

    <com.jarvis.assistant.ui.WaveformView
        android:id="@+id/waveform"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/txtTapHint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/quickActionsRow" />

    <LinearLayout
        android:id="@+id/quickActionsRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/waveform"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/panelTranscript">
        <TextView android:id="@+id/btnQuickCall" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:background="@drawable/bg_quick_chip" android:gravity="center"
            android:text="Call" android:textColor="@color/hud_cyan" android:textSize="11sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/btnQuickMsg" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:background="@drawable/bg_quick_chip" android:gravity="center"
            android:text="Message" android:textColor="@color/hud_cyan" android:textSize="11sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/btnQuickWa" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:background="@drawable/bg_quick_chip" android:gravity="center"
            android:text="WhatsApp" android:textColor="@color/hud_cyan" android:textSize="11sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/btnQuickCam" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1"
            android:background="@drawable/bg_quick_chip" android:gravity="center"
            android:text="Camera" android:textColor="@color/hud_cyan" android:textSize="11sp" android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panelTranscript"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/liquid_glass_card"
        android:padding="14dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/quickActionsRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/panelResponse">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="YOU" android:textColor="@color/hud_cyan_dim" android:textSize="9sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/txtTranscript" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="Say something…"
            android:textColor="@color/hud_cyan_bright" android:textSize="13sp" android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panelResponse"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/liquid_glass_card"
        android:padding="14dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/panelTranscript"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/txtFooter">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="JARVIS" android:textColor="@color/hud_cyan_dim" android:textSize="9sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/txtResponse" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="How can I help you?"
            android:textColor="@color/hud_cyan" android:textSize="14sp" android:fontFamily="monospace" android:minLines="2" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JARVIS  ·  SOFT GLASS"
        android:fontFamily="@font/share_tech_mono"
        android:textColor="#3A5A68"
        android:textSize="9sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
