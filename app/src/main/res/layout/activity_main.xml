<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_screen_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <com.jarvis.assistant.ui.HudOverlayView
        android:id="@+id/hudOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.jarvis.assistant.ui.CornerFrameView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/topBrandRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="3dp"
            android:layout_height="18dp"
            android:background="@drawable/hud_accent_bar"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/txtSystemLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="J.A.R.V.I.S"
            android:textColor="#00E5FF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:fontFamily="@font/share_tech_mono" />

        <TextView
            android:id="@+id/txtClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/statusChipStrip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/topBrandRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM IDLE"
                android:textColor="#00E5FF"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:background="@drawable/glass_chip_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/txtBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BATT --%"
                android:textColor="#B8D4E0"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:background="@drawable/glass_chip_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/txtNetwork"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NET"
                android:textColor="#B8D4E0"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:background="@drawable/glass_chip_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/txtPerf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYS"
                android:textColor="#5A8A9A"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:background="@drawable/glass_chip_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/txtSettingsBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙ SETTINGS"
                android:textColor="#00E5FF"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:background="@drawable/glass_button_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/txtChatBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬 CHAT"
                android:textColor="#00E5FF"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:background="@drawable/glass_button_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/locWeatherRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/statusChipStrip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LOCATING…"
            android:textColor="#5A8A9A"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/txtWeather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#00E5FF"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <com.jarvis.assistant.ui.ArcReactorView
        android:id="@+id/arcReactor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintWidth_percent="0.58"
        app:layout_constraintTop_toBottomOf="@id/locWeatherRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/txtTapHint"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.35" />

    <TextView
        android:id="@+id/txtTapHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TAP CORE TO SPEAK"
        android:textColor="#0B7A94"
        android:textSize="10sp"
        android:letterSpacing="0.15"
        android:fontFamily="monospace"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/arcReactor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/waveform" />

    <com.jarvis.assistant.ui.WaveformView
        android:id="@+id/waveform"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/txtTapHint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/panelTranscript" />

    <LinearLayout
        android:id="@+id/panelTranscript"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/glass_panel_bg"
        android:padding="14dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/waveform"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <View
                android:layout_width="3dp"
                android:layout_height="12dp"
                android:background="@drawable/hud_accent_bar"
                android:layout_marginEnd="8dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INPUT"
                android:textColor="#5A8A9A"
                android:textSize="10sp"
                android:letterSpacing="0.1"
                android:fontFamily="monospace" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="—"
            android:textColor="#F0FBFF"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:minLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panelResponse"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/glass_panel_bg"
        android:padding="14dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/panelTranscript"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/txtFooter">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <View
                android:layout_width="3dp"
                android:layout_height="12dp"
                android:background="@drawable/hud_accent_bar"
                android:layout_marginEnd="8dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESPONSE"
                android:textColor="#0B7A94"
                android:textSize="10sp"
                android:letterSpacing="0.1"
                android:fontFamily="monospace" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Standing by."
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:minLines="2" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DEVELOPER NAVEEN KHATRI  //  JARVIS V7"
        android:fontFamily="@font/share_tech_mono"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:textColor="#3A5A68"
        android:textSize="9sp"
        android:letterSpacing="0.08"
        android:fontFamily="monospace"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center" />

</androidx.constraintlayout.widget.ConstraintLayout>
