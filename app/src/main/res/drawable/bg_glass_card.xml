<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#AA0A1520" />
            <stroke android:width="0.8dp" android:color="#4000E5FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:gravity="top" android:height="18dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#18FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="15dp" android:topRightRadius="15dp" />
        </shape>
    </item>
</layer-list>
