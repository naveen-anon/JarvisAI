<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1200E5FF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="145"
                android:startColor="#99081218"
                android:centerColor="#88060E14"
                android:endColor="#AA0A141C" />
            <corners android:radius="19dp" />
            <stroke android:width="0.8dp" android:color="#3800E5FF" />
        </shape>
    </item>
    <item android:left="10dp" android:top="2dp" android:right="10dp" android:bottom="55dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#22FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
