<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#C0051528"/>
            <stroke android:width="1.4dp" android:color="#8800E5FF"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item android:gravity="top" android:height="14dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#30FFFFFF" android:endColor="#00FFFFFF"/>
            <corners android:topLeftRadius="16dp" android:topRightRadius="16dp"/>
        </shape>
    </item>
</layer-list>
