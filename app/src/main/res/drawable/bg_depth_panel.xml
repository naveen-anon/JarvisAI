<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- deep shadow -->
    <item android:top="3dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#66000000" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- body -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#CC071018" />
            <stroke android:width="1dp" android:color="#5500E5FF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- top gloss -->
    <item android:bottom="3dp" android:top="1dp" android:left="1dp" android:right="1dp" android:height="22dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#28FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="17dp" android:topRightRadius="17dp" />
        </shape>
    </item>
</layer-list>
