<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D0082030"/>
            <stroke android:width="1.8dp" android:color="#00E5FF"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>
    <item android:gravity="top" android:height="16dp" android:left="2dp" android:right="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#35FFFFFF" android:endColor="#00FFFFFF"/>
            <corners android:topLeftRadius="26dp" android:topRightRadius="26dp"/>
        </shape>
    </item>
</layer-list>
