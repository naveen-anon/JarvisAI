<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26122230" />
            <stroke android:width="1dp" android:color="#5500E5FF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:gravity="top" android:height="10dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#20FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
