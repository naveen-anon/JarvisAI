<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#60FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:startColor="#00D9FF" android:endColor="#0099BB" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:gravity="top" android:height="18dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#40FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:topLeftRadius="14dp" android:topRightRadius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
