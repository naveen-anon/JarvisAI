<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40001018">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:startColor="#00E5FF" android:endColor="#00A8CC" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:gravity="top" android:height="16dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#40FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:topLeftRadius="9dp" android:topRightRadius="9dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
