<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3000D9FF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#B30A1825" />
                    <corners android:radius="20dp" />
                    <stroke android:width="1dp" android:color="#55FFFFFF" />
                </shape>
            </item>
            <item android:gravity="top" android:height="22dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#40FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:topLeftRadius="19dp" android:topRightRadius="19dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
