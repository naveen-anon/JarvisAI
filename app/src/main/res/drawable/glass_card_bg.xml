<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#3000D9FF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#280A1825" />
                    <stroke android:width="1dp" android:color="#5500D9FF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:gravity="top" android:height="20dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#22FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:topLeftRadius="15dp" android:topRightRadius="15dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
