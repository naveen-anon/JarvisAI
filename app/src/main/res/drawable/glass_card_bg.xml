<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3000E5FF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#241A2E38" />
                    <stroke android:width="1dp" android:color="#4000E5FF" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:gravity="top" android:height="22dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#2AFFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:topLeftRadius="13dp" android:topRightRadius="13dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
