<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4000E5FF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#26122230" />
                    <stroke android:width="1.5dp" android:color="#8000E5FF" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:gravity="top" android:height="16dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#26FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:topLeftRadius="9dp" android:topRightRadius="9dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
