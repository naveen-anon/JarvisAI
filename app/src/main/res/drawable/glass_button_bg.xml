<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4000D9FF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#CC0A1520" />
                    <corners android:radius="28dp" />
                    <stroke android:width="1dp" android:color="#66FFFFFF" />
                </shape>
            </item>
            <item android:gravity="top" android:height="18dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#55FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:topLeftRadius="27dp" android:topRightRadius="27dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
