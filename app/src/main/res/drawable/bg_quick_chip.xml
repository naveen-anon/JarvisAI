<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#AA0D1A24" />
            <stroke android:width="0.8dp" android:color="#4000E5FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:gravity="top" android:height="16dp" android:left="2dp" android:right="2dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#14FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="12dp" android:topRightRadius="12dp" />
        </shape>
    </item>
</layer-list>
