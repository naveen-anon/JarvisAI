<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#241A2E38" />
            <stroke android:width="1dp" android:color="#4000E5FF" />
            <corners android:radius="16dp" />
            <padding android:left="14dp" android:top="12dp" android:right="14dp" android:bottom="12dp" />
        </shape>
    </item>
    <item android:gravity="top" android:height="16dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#26FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="15dp" android:topRightRadius="15dp" />
        </shape>
    </item>
</layer-list>
